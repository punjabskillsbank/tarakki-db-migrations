<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <changeSet id="TK_165_CREATE_PERMISSIONS_TABLE" author="Ishmeet Singh">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="permissions"/>
            </not>
        </preConditions>

        <createTable tableName="permissions">
            <column name="permission_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="permission_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="permission_description" type="VARCHAR(255)"/>
        </createTable>

        <rollback>
            <dropTable tableName="permissions"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

